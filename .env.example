# Backend Service Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173", "http://127.0.0.1:3000"]

# Database Configuration
# Local path relative to backend or absolute path
DATABASE_URL=sqlite+aiosqlite:///./data/wind_procurement.db

# Elexon BMRS Insights API Configuration
ELEXON_BASE_URL=https://data.elexon.co.uk/bmrs/api/v1
ELEXON_TIMEOUT_SECONDS=30.0
ELEXON_MAX_RETRIES=3

# Procurement Decision Defaults (Client Confirmation Assumption)
# Default gate closure / decision cutoff on D-1 in UK local time (HH:MM)
DEFAULT_DECISION_CUTOFF=11:00
DEFAULT_TIMEZONE=Europe/London

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000
